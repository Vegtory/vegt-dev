---
/**
 * @component Hero
 * @version   2.0.0
 * @updated   2026-09-11
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * The opening screen: a photograph of a person, their name, and a sentence
 * that sounds like them.
 *
 * The previous version led with a job title over a near-black band with two
 * drifting glows and a panning dot grid. All of that is gone. What replaced it:
 *
 * - The portrait is a photograph at size, not a circular avatar, set against
 *   an offset cobalt plate so it reads as something pasted onto the page.
 * - The name is the headline; the job title is not on the page at all. What
 *   the reader gets instead is `intro` — one sentence covering software,
 *   hardware, photography and writing, because that combination is the thing
 *   worth remembering, and "Full-stack Software Developer" is not.
 * - `currently` is the detail that makes this his page rather than a template:
 *   a real, slightly daft status line. Keep it current or delete it; a stale
 *   "currently" is worse than none.
 *
 * ---------------------------------------------------------------------------
 * ONE NUMBER TO KNOW, if the portrait ever looks soft, or looks too small.
 *
 * This design wants the portrait at roughly 40% of the viewport. It is not
 * there, and the reason is the asset: `src/assets/image.jpeg` is 400x400, and
 * `CustomPicture` never upscales — hand it a 400px file and 400px is all any
 * screen gets, however large the slot.
 *
 * So `PORTRAIT_SLOT` is pinned to 320px, which with the 4:5 crop below puts
 * the frame at exactly 320x400: the largest this file fills at native
 * resolution, with nothing invented. The column earns its presence from the
 * taller crop, the cobalt plate and the caption under it instead of from
 * pixels that are not in the file.
 *
 * Replace the source with a ~1200px portrait and this opens straight up:
 * set `PORTRAIT_SLOT` to `w-64 sm:w-80 lg:w-[26rem]` and update `sizes` to
 * match. Nothing else needs touching.
 * ---------------------------------------------------------------------------
 */
import type { ImageMetadata } from "astro";
import CustomPicture from "@ui/CustomPicture.astro";
import TextRender from "@ui/TextRender.astro";
import Button from "@ui/Button.astro";
import Annotation from "@ui/Annotation.astro";
import Connector from "@ui/Connector.astro";
import MetaLine from "@ui/MetaLine.astro";

export interface ImageItem {
  image: ImageMetadata | string;
  description?: string;
  subText?: string;
}

export interface HeroLink {
  label: string;
  link: string;
}

export interface Props {
  /** The name. This is the headline — not a job title. */
  title?: string;
  /** One sentence that sounds like a person wrote it. */
  intro?: string;
  /** The mono strip: "software · cloud · homelab · maken · fotografie". */
  meta?: string[];
  /** Honest, specific, slightly daft. Delete it rather than let it go stale. */
  currently?: string;
  /** Pencilled note beside the portrait. */
  note?: string;
  /** First is rendered solid, the rest outlined. Two is plenty. */
  ctas?: HeroLink[];
  imageItems?: ImageItem[];
}

const {
  title = "",
  intro = "",
  meta = [],
  currently = "",
  note = "",
  ctas = [],
  imageItems = [],
} = Astro.props;

const portrait = imageItems[0];

/** See the long note above before changing this. */
const PORTRAIT_SLOT = "w-52 sm:w-64 lg:w-80";
---

<section class="relative overflow-hidden border-b border-hairline bg-background">
  {/* Graph paper, bottom-left only. A whole page of it would be a texture; a
      corner of it reads as the pad the page was drafted on. */}
  <div
    class="pointer-events-none absolute -bottom-8 left-0 h-72 w-72 bg-graph bg-[length:22px_22px] opacity-50 [mask-image:radial-gradient(circle_at_bottom_left,black,transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-12 sm:pb-24 sm:pt-16 lg:px-8">
    <div class="flex flex-col-reverse gap-12 md:flex-row md:items-start md:gap-14">
      {/* --- Text column ------------------------------------------------- */}
      <div class="w-full min-w-0 md:pt-6">
        {
          meta.length > 0 && (
            <div class="motion-safe:animate-rise-in">
              <MetaLine items={meta} shape="dots" size="sm" />
            </div>
          )
        }

        <h1
          class="mt-6 text-pretty text-[2.6rem] font-semibold leading-[0.98] tracking-[-0.035em] text-primaryText motion-safe:animate-rise-in sm:text-6xl lg:text-[4.2rem]"
          style="animation-delay: 70ms;"
        >
          <TextRender>{title}</TextRender>
          {/* The caret. Used exactly once on the entire site, in ink rather
              than in an accent, because a page where every heading types
              itself out is a terminal theme — which is the look this design
              exists to avoid. */}
          <span
            class="ml-1 inline-block h-[0.72em] w-[2px] translate-y-[0.02em] bg-ink-950/70 motion-safe:animate-blink"
            aria-hidden="true"></span>
        </h1>

        {
          intro && (
            <p
              class="mt-7 max-w-xl text-pretty text-lg leading-relaxed text-blackText motion-safe:animate-rise-in sm:text-xl"
              style="animation-delay: 140ms;"
            >
              <TextRender>{intro}</TextRender>
            </p>
          )
        }

        {
          currently && (
            <div
              class="mt-8 flex max-w-xl items-start gap-3 border-l-2 border-acid pl-4 motion-safe:animate-rise-in"
              style="animation-delay: 210ms;"
            >
              <p class="font-mono text-[0.8125rem] leading-relaxed text-mutedText">
                <span class="text-primaryText">op dit moment</span>
                <span class="text-hairlineStrong" aria-hidden="true"> : </span>
                <TextRender>{currently}</TextRender>
              </p>
            </div>
          )
        }

        {
          ctas.length > 0 && (
            <div
              class="mt-10 flex flex-wrap gap-3 motion-safe:animate-rise-in"
              style="animation-delay: 280ms;"
            >
              {ctas.map((cta, i) => (
                <Button
                  href={cta.link}
                  variant={i === 0 ? "primary" : "secondary"}
                  arrow={i === 0}
                >
                  <TextRender>{cta.label}</TextRender>
                </Button>
              ))}
            </div>
          )
        }
      </div>

      {/* --- Portrait column ---------------------------------------------
          Breaks the grid on purpose: it sits higher than the text column and
          hangs a little past the right margin on wide screens. A hero where
          both columns start on the same line is a template; this one looks
          placed. */}
      {
        portrait?.image && (
          <div class="shrink-0 self-start motion-safe:animate-rise-in md:-mt-1" style="animation-delay: 120ms;">
            <div class:list={["relative", PORTRAIT_SLOT]}>
              {/* The cobalt plate. Offset behind the photograph, squared off,
                  like a registration block on a proof sheet. */}
              <div
                class="absolute -left-3 -top-3 h-full w-full bg-cobalt"
                aria-hidden="true"
              />

              {/* 4:5 rather than the source's own square. A portrait crop is
                  the editorial shape, it is the "slightly unconventional crop"
                  this design asks for, and at this width it lands at exactly
                  320x400 — the tallest frame a 400px file fills without being
                  upscaled. Quality is high because the file is tiny and this
                  is the only face above the fold. */}
              <CustomPicture
                alt={portrait.description}
                classes="relative aspect-[4/5] w-full"
                sizes="(max-width: 639px) 208px, (max-width: 1023px) 256px, 320px"
                srcImagePath={portrait.image}
                priority={true}
                qualityOverride={84}
              />

              {/* Corner registration marks, on the two free corners. */}
              <span class="absolute -bottom-1 -right-1 h-3 w-3 border-b border-r border-ink-950" aria-hidden="true" />
              <span class="absolute -right-1 -top-1 h-3 w-3 border-r border-t border-ink-950" aria-hidden="true" />
            </div>

            {/* The note sits under the frame, in flow. It used to be absolutely
                positioned into the left margin, where it ran underneath the
                photograph at every width the two happened to overlap. */}
            {
              note && (
                <div class:list={["mt-5", PORTRAIT_SLOT]}>
                  <Connector tone="cobalt" />
                  <Annotation arrow="none" tone="note" tilt={-1} class="mt-4 max-w-none">
                    {note}
                  </Annotation>
                </div>
              )
            }
          </div>
        )
      }
    </div>
  </div>
</section>
