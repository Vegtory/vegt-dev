---
/**
 * @component BlogList
 * @version   2.0.0
 * @updated   2026-09-11
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * The full index of posts, on /blog.
 *
 * Restyled to match the homepage's SCHRIJVEN section entry-for-entry: the same
 * hairline lattice, the same mono date line, the same topic pad. The two lists
 * link to each other, so a reader who follows "Alle notities" should land on
 * something they recognise rather than on a second design.
 */
import { getCollection } from "astro:content";
import CustomPicture from "@ui/CustomPicture.astro";
import TextRender from "@ui/TextRender.astro";
import { formatDate } from "@ui/date";
import { topicFor } from "@ui/topics";

const allBlogs = await getCollection("blog");
const blogs = allBlogs
  .filter(({ data }) => !data.ishidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<ul class="border-t border-hairline">
  {
    blogs.map(({ id, data }, i) => {
      const topic = topicFor(data.topic);
      return (
        <li data-reveal style={`--reveal-delay: ${Math.min(i, 5) * 80}ms`}>
          <a
            href={`/blog/${id}`}
            class="group flex items-start gap-5 border-b border-hairline py-7 no-underline transition-colors hover:bg-surfaceMuted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ink-950 sm:gap-6"
          >
            <div class="w-28 shrink-0 overflow-hidden sm:w-36">
              <CustomPicture
                alt={data.description}
                classes="aspect-[4/3] w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                sizes="(min-width: 640px) 144px, 112px"
                srcImagePath={data.imageItem.image}
                loading="lazy"
              />
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[0.6875rem] text-mutedText">
                <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
                {topic && (
                  <>
                    <span class="text-hairlineStrong" aria-hidden="true">·</span>
                    <span class="inline-flex items-center gap-1.5">
                      {/* Pad carries the colour, label stays ink — two of the
                          five marks are too light to set type in. */}
                      <span class:list={["h-1.5 w-1.5", topic.mark]} aria-hidden="true" />
                      {topic.id}
                    </span>
                  </>
                )}
              </div>

              <h2 class="mt-2.5 line-clamp-2 text-lg font-semibold leading-snug tracking-[-0.01em] text-primaryText">
                <TextRender>{data.title}</TextRender>
              </h2>

              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-mutedText">
                <TextRender>{data.description}</TextRender>
              </p>
            </div>

            <span
              class="hidden shrink-0 self-center text-hairlineStrong transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primaryText sm:block"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
