---
/**
 * @component ScrollReveal
 * @version   1.0.0
 * @updated   2026-09-10
 *
 * Reveals `[data-reveal]` elements as they scroll into view. Rendered once,
 * from `BaseLayout`'s <head>, and picked up by every page.
 *
 * The whole design here is about the failure mode. A scroll reveal hides
 * content and relies on script to bring it back, so anything that stops the
 * script — JS disabled, a parse error, an old browser, a blocked bundle —
 * leaves a blank page. So this is built the other way round:
 *
 *   - The hidden state lives under `html.reveal-on`, a class only ever added
 *     BY the script. No script, no class, no hiding: the page renders
 *     complete, just without the animation.
 *   - `prefers-reduced-motion: reduce` returns before adding the class, so
 *     that reader gets a still page rather than a faster-moving one.
 *   - Everything is wrapped in try/catch, and the catch removes the class.
 *   - It is `is:inline` in <head> rather than a bundled module, so the class
 *     lands before first paint. A deferred script would let one frame of
 *     visible content through before hiding it — a flash of exactly the
 *     content the effect is supposed to introduce.
 *
 * Stagger a group by setting `--reveal-delay` on each child; see
 * `ToolsShowcase` for the pattern.
 */
---

<style is:global>
  /* Both properties are compositor-only, so a long list of revealing cards
     costs no layout work. `will-change` is deliberately absent: it would
     promote every tagged element on the page to its own layer up front, which
     is a memory cost paid for elements that may never be reached. */
  html.reveal-on [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
  }

  html.reveal-on [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  /* A hairline that draws itself out once its container arrives — the rule
     beside a section eyebrow. Opting in with an attribute rather than a
     Tailwind arbitrary variant, because the selector needs two ancestor
     conditions and that does not survive the class-name parser. */
  html.reveal-on [data-reveal] [data-reveal-rule] {
    transform: scaleX(0);
  }

  html.reveal-on [data-reveal].is-revealed [data-reveal-rule] {
    transform: scaleX(1);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    try {
      // Bail before touching the DOM if we cannot honour the contract.
      if (!("IntersectionObserver" in window)) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      root.classList.add("reveal-on");

      var start = function () {
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (!entries[i].isIntersecting) continue;
              entries[i].target.classList.add("is-revealed");
              // One-shot: re-animating on the way back up is nauseating, and
              // un-observing keeps the callback cheap on long pages.
              io.unobserve(entries[i].target);
            }
          },
          // Fires a little before the element's top edge reaches the fold, so
          // the movement finishes about when the reader gets there.
          { rootMargin: "0px 0px -8% 0px", threshold: 0.01 },
        );

        var nodes = document.querySelectorAll("[data-reveal]");
        for (var i = 0; i < nodes.length; i++) io.observe(nodes[i]);
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start);
      } else {
        start();
      }
    } catch (e) {
      // Never leave the page hidden because the effect failed.
      root.classList.remove("reveal-on");
    }
  })();
</script>
