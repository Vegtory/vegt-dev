---
/**
 * @component TextWithLargeImage
 * @version   2.0.0
 * @updated   2026-09-11
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * The About section: the longest single run of prose on the site.
 *
 * Set as a two-column editorial spread — the heading holds the left column and
 * the prose runs in the right — so the page's densest text arrives looking
 * like an article rather than like a centred hero paragraph. On narrow screens
 * it stacks, and the measure stays the same either way.
 */
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import CustomPicture from "@ui/CustomPicture.astro";
import SectionHeading from "@ui/SectionHeading.astro";
import { proseBase } from "@ui/prose";

export interface ImageItem {
  image: ImageMetadata | string;
  description?: string;
  subText?: string;
}

export interface IconComponent {
  title: string;
  text: string;
  /** Icon name resolved against the astro-icon `iconDir`. */
  icon: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  topic?: string;
  index?: string;
  imageItem?: ImageItem;
  bulletPoints?: IconComponent[];
}

const {
  title = "",
  subtitle = "",
  topic,
  index = "",
  imageItem,
  bulletPoints = [],
} = Astro.props;
---

<section class="bg-background py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      {/* Sticky on desktop. This is the longest run of prose on the site, and
          a static heading left most of a 5-column gutter empty beside it —
          which reads as a layout that ran out rather than as whitespace. Held
          in view, the column becomes the running head of the spread. */}
      <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
        <SectionHeading topic={topic} eyebrow={subtitle} title={title} index={index} />
      </div>

      {/* The measure lives on this wrapper, not on the prose element: the
          `max-w-none` inside `proseBase` is there so typography does not impose
          its own width, and two max-width utilities on one element resolve by
          stylesheet order rather than by which one you meant. */}
      <div class="max-w-2xl lg:col-span-7" data-reveal style="--reveal-delay: 90ms">
        <div class={proseBase}><slot /></div>
      </div>
    </div>

    {
      imageItem?.image && (
        <div class="mt-14" data-reveal>
          <CustomPicture
            alt={imageItem.description}
            classes="w-full"
            sizes="(min-width: 1280px) 1152px, (min-width: 1040px) 960px, (min-width: 780px) 720px, calc(94.44vw - 31px)"
            srcImagePath={imageItem.image}
            loading="lazy"
            subText={imageItem.subText}
          />
        </div>
      )
    }

    {
      bulletPoints.length > 0 && (
        <dl class="mt-16 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {bulletPoints.map((bulletPoint, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <dt class="flex items-center gap-3 font-semibold text-primaryText">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center border border-hairline bg-surfaceMuted text-primaryText">
                  <Icon name={bulletPoint.icon} class="h-4 w-4" />
                </span>
                {bulletPoint.title}
              </dt>
              <dd class="mt-3 leading-relaxed text-mutedText">{bulletPoint.text}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
