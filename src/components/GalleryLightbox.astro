---
import CustomPicture from '@ui/CustomPicture.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  albums: Array<{
    slug: string;
    images: Array<{
      metadata: ImageMetadata;
      alt: string;
    }>;
  }>;
}

const { albums } = Astro.props;
---

<!-- Lightbox overlay -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-50 hidden bg-black/70 items-center justify-center cursor-zoom-out"
  role="dialog"
  aria-modal="true"
  aria-label="Foto lightbox"
>
  <div
    id="lightbox-image-slot"
    class="relative cursor-default"
  >
    <!-- Pre-rendered CustomPicture clone is injected here -->
  </div>

  <div id="lightbox-counter" class="absolute top-4 left-1/2 -translate-x-1/2 text-white/60 text-xs font-medium tracking-widest pointer-events-none"></div>

  <button id="lightbox-close" class="absolute top-3 right-3 p-2 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button id="lightbox-prev" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 p-3 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button id="lightbox-next" class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 p-3 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>

<!-- Pre-rendered lightbox images (hidden at build time, cloned in on click) -->
<div id="lightbox-pool" class="hidden" aria-hidden="true">
  {albums.map(({ slug, images }) => (
    <div data-album={slug}>
      {images.map((img, idx) => (
        <div data-idx={idx}>
          <!--
            Size the wrapper using CSS min() so the image fills as much of the
            viewport as possible while respecting both max-width (90vw) and
            max-height (85vh) constraints for any aspect ratio.
          -->
          <div
            style={`width: min(${img.metadata.width}px, 90vw, ${((img.metadata.width / img.metadata.height) * 85).toFixed(2)}vh); aspect-ratio: ${img.metadata.width}/${img.metadata.height};`}
          >
            <CustomPicture
              srcImagePath={img.metadata}
              alt={img.alt}
              classes="w-full rounded-md shadow-2xl"
              sizes="(min-width: 1024px) 85vw, 90vw"
              qualityOverride={90}
              widthsOverride={[960, 1280, 1920, 2560, 3840]}
              loading="lazy"
            />
          </div>
        </div>
      ))}
    </div>
  ))}
</div>

<script>
  const overlay = document.getElementById('gallery-lightbox')!;
  const slot = document.getElementById('lightbox-image-slot')!;
  const counter = document.getElementById('lightbox-counter')!;
  const closeBtn = document.getElementById('lightbox-close')!;
  const prevBtn = document.getElementById('lightbox-prev')!;
  const nextBtn = document.getElementById('lightbox-next')!;

  let album = '';
  let index = 0;
  let total = 0;

  function pool(albumSlug: string) {
    return document.querySelector<HTMLElement>(`#lightbox-pool [data-album="${albumSlug}"]`);
  }

  function show(albumSlug: string, idx: number) {
    const albumPool = pool(albumSlug);
    if (!albumPool) return;
    const items = albumPool.querySelectorAll('[data-idx]');
    total = items.length;
    album = albumSlug;
    index = idx;

    const item = albumPool.querySelector<HTMLElement>(`[data-idx="${idx}"]`);
    if (!item) return;

    slot.innerHTML = '';
    slot.appendChild(item.cloneNode(true));
    counter.textContent = `${idx + 1} / ${total}`;
    prevBtn.style.display = total > 1 ? '' : 'none';
    nextBtn.style.display = total > 1 ? '' : 'none';
  }

  function open(albumSlug: string, idx: number) {
    show(albumSlug, idx);
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function prev() { show(album, (index - 1 + total) % total); }
  function next() { show(album, (index + 1) % total); }

  overlay.addEventListener('click', close);
  slot.addEventListener('click', (e) => e.stopPropagation());
  closeBtn.addEventListener('click', (e) => { e.stopPropagation(); close(); });
  prevBtn.addEventListener('click', (e) => { e.stopPropagation(); prev(); });
  nextBtn.addEventListener('click', (e) => { e.stopPropagation(); next(); });

  document.addEventListener('keydown', (e) => {
    if (overlay.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
  });

  window.addEventListener('gallery:open', (e: Event) => {
    const { albumSlug, index: idx } = (e as CustomEvent<{ albumSlug: string; index: number }>).detail;
    open(albumSlug, idx);
  });
</script>
