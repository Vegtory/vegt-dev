---
/**
 * @component SiteFooter
 * @version   1.2.0
 * @updated   2026-09-28
 *
 * `Footer` wired to `src/site.ts`. See `SiteHeader` for why this wrapper
 * exists. The `#contact` id lives here so any page's contact link has
 * somewhere to land, not just the homepage.
 */
import Footer from "@ui/Footer.astro";
import ContactForm from "@ui/ContactForm.astro";
import { site } from "../site";
---

<div id="contact">
  <Footer
    wordmark={site.wordmark}
    email={site.email}
    contactTitle="Contact"
    contactText="Een vraag, een idee, of gewoon zin om ergens over te sparren? Mail me gerust, of laat hier een bericht achter."
    links={site.nav}
    githubLink={site.social.github}
    linkedinLink={site.social.linkedin}
    instagramLink={site.social.instagram}
    copyrightText={site.name}
  >
    <ContactForm slot="form" />
  </Footer>
</div>
