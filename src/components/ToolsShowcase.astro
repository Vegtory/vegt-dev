---
/**
 * @component ToolsShowcase
 * @version   1.0.0
 * @updated   2026-09-10
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * Copied from the template and restyled onto this site's tokens.
 *
 * - Cards drop from `rounded-3xl` to the `2xl` card radius, so they match the
 *   blog cards and photo frames instead of being a fourth distinct shape.
 * - `bg-white`/`ring-gray-200`/`text-gray-600` become `surface`/`hairline`/
 *   `mutedText`. The raw greys were cool while the page background is warm,
 *   which is why the cards read as slightly "off" against it.
 * - The card link is a mono label, matching the eyebrows and hero chips, and
 *   it inherits the one link colour rather than being a third blue.
 * - The whole card is the click target, so the arrow no longer needs to be
 *   the only affordance.
 */
import TextRender from "@ui/TextRender.astro";
import SectionHeading from "@ui/SectionHeading.astro";
import { proseBase } from "@ui/prose";

export interface ToolItem {
  title: string;
  description: string;
  link: string;
  linkLabel: string;
  /** Key into `iconPaths` below; anything unknown falls back to a star. */
  icon: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  tools?: ToolItem[];
}

const { title = "", subtitle = "", tools = [] } = Astro.props;

// Inline SVG paths keyed by the tool's `icon` field. The site does not load a
// Font Awesome webfont, so icons are rendered as inline SVG to stay consistent.
const iconPaths: Record<string, string> = {
  wrench:
    "M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437",
  chart:
    "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z",
};
const defaultIcon =
  "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z";
---

<section class="bg-background py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <SectionHeading eyebrow={subtitle} title={title} align="left" />

    {/* The measure lives on this wrapper, not on the prose element: the
        `max-w-none` inside `proseBase` is there so typography does not impose
        its own width, and two max-width utilities on one element resolve by
        stylesheet order rather than by which one you meant. */}
    <div class="mt-8 max-w-2xl" data-reveal style="--reveal-delay: 90ms">
      <div class={proseBase}><slot /></div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        tools.map((tool, i) => (
          <a
            href={tool.link}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
            style={`--reveal-delay: ${i * 110}ms`}
            class="group flex flex-col rounded-2xl border border-hairline bg-surface p-7 no-underline shadow-sm transition duration-200 hover:-translate-y-1 hover:border-primary-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            <div class="flex items-center gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-surfaceMuted text-accentText ring-1 ring-hairline transition duration-300 group-hover:scale-105 group-hover:bg-primary-50 group-hover:ring-primary-200">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[tool.icon] ?? defaultIcon} />
                </svg>
              </span>
              <h3 class="font-mono text-base font-semibold text-primaryText">
                <TextRender>{tool.title}</TextRender>
              </h3>
            </div>

            <p class="mt-5 flex-1 leading-relaxed text-mutedText">
              <TextRender>{tool.description}</TextRender>
            </p>

            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 transition-colors group-hover:text-primary-700">
              <TextRender>{tool.linkLabel}</TextRender>
              <svg
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
