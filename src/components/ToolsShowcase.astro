---
/**
 * @component ToolsShowcase
 * @version   2.1.0
 * @updated   2026-09-11
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * The BOUWEN section: things with a URL that William made.
 *
 * Restyled from a row of rounded SaaS cards into pasted-in rectangles — square
 * corners, a hairline box, one coloured edge along the top, and a status chip
 * set like a line out of a config file. The cards are deliberately not all the
 * same height, and the grid is a 5-column one they sit across unevenly, so the
 * row reads as arranged rather than as generated.
 *
 * Each card carried a row of faint package-style tags under the status chip
 * (`hillchart@web`, `shape-up@methode`). They are gone: the card already says
 * what the thing is in a full sentence, and a second, terser restatement of it
 * in a code voice was the joke told twice. The status chip is the one place
 * here still dressed as code, which is about the right ration.
 */
import TextRender from "@ui/TextRender.astro";
import SectionHeading from "@ui/SectionHeading.astro";
import StatusChip from "@ui/StatusChip.astro";
import Annotation from "@ui/Annotation.astro";
import { proseBase } from "@ui/prose";

export interface ToolStatus {
  label: string;
  value: string;
  state?: "neutral" | "ok" | "wip" | "off";
  live?: boolean;
}

export interface ToolItem {
  title: string;
  description: string;
  link: string;
  linkLabel: string;
  /** Key into `iconPaths` below; anything unknown falls back to a star. */
  icon: string;
  status?: ToolStatus;
}

export interface Props {
  title?: string;
  subtitle?: string;
  topic?: string;
  index?: string;
  note?: string;
  tools?: ToolItem[];
}

const {
  title = "",
  subtitle = "",
  topic,
  index = "",
  note = "",
  tools = [],
} = Astro.props;

// Inline SVG paths keyed by the tool's `icon` field. The site loads no icon
// webfont, so these are inline rather than a Font Awesome request.
const iconPaths: Record<string, string> = {
  wrench:
    "M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437",
  chart:
    "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z",
};
const defaultIcon =
  "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z";

/**
 * The marked top edge, cycling through the palette per card.
 *
 * This is where the "colour is incidental" rule gets enforced: the hue carries
 * no meaning, it is just which cable happened to be in the drawer. Complete
 * literals, because Tailwind cannot see a runtime-assembled class name.
 */
const edges = ["border-t-cobalt", "border-t-tomato", "border-t-violet", "border-t-amber"];
---

<section class="bg-background py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <SectionHeading topic={topic} eyebrow={subtitle} title={title} index={index} />

    <div class="mt-8 flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      {/* The measure lives on this wrapper, not on the prose element: the
          `max-w-none` inside `proseBase` is there so typography does not impose
          its own width, and two max-width utilities on one element resolve by
          stylesheet order rather than by which one you meant. */}
      <div class="max-w-2xl" data-reveal style="--reveal-delay: 90ms">
        <div class={proseBase}><slot /></div>
      </div>

      {
        note && (
          <Annotation arrow="left-down" tone="cobalt" tilt={2} class="shrink-0 md:mt-2">
            {note}
          </Annotation>
        )
      }
    </div>

    {/* A 5-column grid the cards sit across unevenly — 3/2, then 2/3 — so the
        row is arranged rather than stamped out. Collapses to one column well
        before the asymmetry would start squeezing the text. */}
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-5">
      {
        tools.map((tool, i) => (
          <a
            href={tool.link}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
            style={`--reveal-delay: ${i * 110}ms`}
            class:list={[
              "group flex flex-col border border-t-2 border-hairline bg-surface p-7 no-underline transition-colors duration-200 hover:border-hairlineStrong hover:bg-surfaceMuted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink-950 focus-visible:ring-offset-2 focus-visible:ring-offset-background",
              edges[i % edges.length],
              // Alternating spans: card 0 wide, card 1 narrow, and back.
              i % 2 === 0 ? "md:col-span-3" : "md:col-span-2",
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-mono text-base font-semibold tracking-tight text-primaryText">
                <TextRender>{tool.title}</TextRender>
              </h3>
              <svg
                class="h-5 w-5 shrink-0 text-hairlineStrong transition-colors group-hover:text-primaryText"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[tool.icon] ?? defaultIcon} />
              </svg>
            </div>

            <p class="mt-4 flex-1 leading-relaxed text-mutedText">
              <TextRender>{tool.description}</TextRender>
            </p>

            {tool.status && (
              <div class="mt-6">
                <StatusChip
                  label={tool.status.label}
                  value={tool.status.value}
                  state={tool.status.state}
                  live={tool.status.live}
                />
              </div>
            )}

            <span class="mt-6 inline-flex items-center gap-1.5 border-t border-hairline pt-4 text-sm font-semibold text-cobalt-ink transition-colors group-hover:text-ink-950">
              <TextRender>{tool.linkLabel}</TextRender>
              <svg
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
