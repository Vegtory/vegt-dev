---
/**
 * @component SectionHeading
 * @version   2.0.0
 * @updated   2026-09-11
 *
 * The label + title pair every section opens with, set as a field-journal
 * entry header: a numbered mono label with a coloured pad beside it, then the
 * title in ink.
 *
 * The colour lives in the pad, never in the label text. That is what keeps the
 * palette reading as incidental — a marker dot against a heading — rather than
 * as a per-section colour scheme, which is the thing that makes a site look
 * like a SaaS landing page. It also sidesteps a real problem: two of the five
 * topic marks (`acid`, `amber`) sit below 3:1 on paper and could not legally
 * set type at this size anyway.
 *
 * `topic` ties the heading into the site's five-verb vocabulary (see
 * `topics.ts`); `eyebrow` is the escape hatch for a section that is not one of
 * the five.
 */
import TextRender from "@ui/TextRender.astro";
import { topicFor } from "@ui/topics";

export interface Props {
  /** One of the five verbs. Supplies both the label and its pad colour. */
  topic?: string;
  /** Used when `topic` is not set, or to override its label. */
  eyebrow?: string;
  title?: string;
  /** Two-digit entry number, e.g. "03". Purely editorial furniture. */
  index?: string;
  /**
   * Heading level. Sections on a page that already has an `<h1>` want `h2`
   * (the default); a page whose main title this *is* — /blog, /gallery —
   * passes `h1`, so the document is not left without one. Size is set by the
   * classes below either way, so this changes the outline, not the look.
   */
  as?: "h1" | "h2";
  /** `sm` for the smaller sub-sections, so not every heading shouts. */
  size?: "sm" | "lg";
  class?: string;
}

const {
  topic,
  eyebrow = "",
  title = "",
  index = "",
  as: Heading = "h2",
  size = "lg",
  class: extraClass = "",
} = Astro.props;

const resolved = topicFor(topic);
const label = eyebrow || resolved?.label || "";
const pad = resolved?.mark ?? "bg-hairlineStrong";
const rule = resolved?.rule ?? "bg-hairline";

const titleSize =
  size === "lg"
    ? "text-[2rem] leading-[1.1] sm:text-[2.75rem]"
    : "text-2xl leading-tight sm:text-3xl";
---

<div class:list={["flex max-w-3xl flex-col", extraClass]} data-reveal>
  {
    label && (
      <p class="flex items-center gap-2.5 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-mutedText">
        {/* The entry number. `mutedText`, not a pale hairline: at 11px a
            hairline-coloured numeral sits near 1.6:1, which is not "quiet
            furniture", it is invisible. Kept quiet by size and by sitting
            before the pad instead. */}
        {index && <span class="tabular-nums text-mutedText">{index}</span>}
        {/* The topic's pad. Square, like every other node on the site. */}
        <span class:list={["h-1.5 w-1.5 shrink-0", pad]} aria-hidden="true" />
        <TextRender>{label}</TextRender>
        {/* Draws itself out as the heading arrives; the states live in
            ScrollReveal's global sheet, keyed off `data-reveal-rule`. */}
        <span
          class:list={["h-px w-10 origin-left", rule]}
          data-reveal-rule
          aria-hidden="true"
        />
      </p>
    )
  }
  {
    title && (
      <Heading
        class:list={[
          "mt-5 text-pretty font-semibold tracking-[-0.02em] text-primaryText",
          titleSize,
        ]}
      >
        <TextRender>{title}</TextRender>
      </Heading>
    )
  }
  <slot />
</div>
