---
/**
 * @component Footer
 * @version   1.0.0
 * @updated   2026-09-10
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * Copied from the template and rebuilt as the closing ink band.
 *
 * The homepage rendered no footer at all, so the only way to contact William
 * was an email address in the middle of a paragraph in the About section.
 * A personal site's whole job is to make that step obvious, so the contact
 * line is now the largest thing in the band.
 *
 * Links come from `src/site.ts`; an empty value renders nothing, so no
 * placeholder profile is ever shown.
 */
import TextRender from "@ui/TextRender.astro";

export interface Props {
  wordmark?: string;
  /** Plain address. The email-obscurer integration reverses it at build time. */
  email?: string;
  /** Invitation shown above the address. */
  contactTitle?: string;
  contactText?: string;
  links?: readonly { label: string; link: string }[];
  githubLink?: string;
  linkedinLink?: string;
  instagramLink?: string;
  copyrightText?: string;
}

const {
  wordmark = "",
  email = "",
  contactTitle = "",
  contactText = "",
  links = [],
  githubLink = "",
  linkedinLink = "",
  instagramLink = "",
  copyrightText = "",
} = Astro.props;

