---
/**
 * @component Footer
 * @version   2.0.0
 * @updated   2026-09-11
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * The closing band: an invitation to mail, the navigation again, and a strip
 * of build metadata.
 *
 * Paper now rather than the near-black plate it used to be, so the page ends
 * the way it started. The email address is the largest thing here on purpose —
 * a personal site's whole job is to make that step obvious, and before this
 * component existed the only way to contact William was an address buried in
 * a paragraph of the About section.
 *
 * The metadata strip is real and has to stay real. `rev` and `commit` come
 * from the build (see `src/buildInfo.ts`); the uptime counts from the build
 * timestamp in the reader's browser. A made-up uptime would be a prop, and a
 * prop is exactly the thing a reader who looks twice can catch — which costs
 * more than the detail is worth.
 *
 * Links come from `src/site.ts`; an empty value renders nothing, so no
 * placeholder profile is ever shown.
 */
import TextRender from "@ui/TextRender.astro";
import Connector from "@ui/Connector.astro";
import AmbientWash from "@ui/AmbientWash.astro";
import { builtAt, rev, commit } from "../buildInfo";

export interface Props {
  wordmark?: string;
  /** Plain address. The email-obscurer integration reverses it at build time. */
  email?: string;
  /** Invitation shown above the address. */
  contactTitle?: string;
  contactText?: string;
  links?: readonly { label: string; link: string }[];
  githubLink?: string;
  linkedinLink?: string;
  instagramLink?: string;
  copyrightText?: string;
}

const {
  wordmark = "",
  email = "",
  contactTitle = "",
  contactText = "",
  links = [],
  githubLink = "",
  linkedinLink = "",
  instagramLink = "",
  copyrightText = "",
} = Astro.props;

const socials = [
  { href: githubLink, label: "GitHub", path: "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" },
  { href: linkedinLink, label: "LinkedIn", path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" },
  { href: instagramLink, label: "Instagram", path: "M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" },
].filter((s) => s.href);

const dot = wordmark.indexOf(".");
const head = dot > -1 ? wordmark.slice(0, dot) : wordmark;
const tail = dot > -1 ? wordmark.slice(dot + 1) : "";
---

<footer class="relative overflow-hidden border-t border-hairline bg-background">
  {/* A faint echo of the hero's washes, so the page closes the way it opened
      rather than ending on flat silver. */}
  <AmbientWash intensity="faint" />

  <div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-20 lg:px-8">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between md:gap-16">
      <div class="max-w-md" data-reveal>
        {
          contactTitle && (
            <p class="flex items-center gap-2.5 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-mutedText">
              <span class="h-1.5 w-1.5 bg-cobalt" aria-hidden="true" />
              <TextRender>{contactTitle}</TextRender>
            </p>
          )
        }
        {
          email && (
            <a
              href={`mailto:${email}`}
              class="group relative mt-5 inline-block text-2xl font-semibold tracking-[-0.02em] text-primaryText no-underline transition-colors hover:text-cobalt-ink sm:text-3xl"
            >
              {email}
              {/* A drawn rule rather than `hover:underline`: the underline
                  would pop in, and this address is the one thing in the band
                  worth drawing the eye to. */}
              <span
                class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-cobalt transition-transform duration-300 ease-out group-hover:scale-x-100"
                aria-hidden="true"
              />
            </a>
          )
        }
        {
          contactText && (
            <p class="mt-6 leading-relaxed text-mutedText">
              <TextRender>{contactText}</TextRender>
            </p>
          )
        }
      </div>

      {
        links.length > 0 && (
          <nav aria-label="Voettekst navigatie" data-reveal style="--reveal-delay: 100ms">
            <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-mutedText">
              Navigatie
            </p>
            <ul class="mt-5 flex flex-col gap-3">
              {links.map((l) => (
                <li>
                  <a
                    href={l.link}
                    class="text-sm text-mutedText no-underline transition-colors hover:text-primaryText"
                  >
                    <TextRender>{l.label}</TextRender>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    <Connector class="mt-14" />

    {/* --- Build metadata ------------------------------------------------
        All of this is real. See src/buildInfo.ts. */}
    <div class="mt-8 flex flex-col-reverse items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.6875rem] text-mutedText">
        <span class="text-mutedText">
          <TextRender>{head}</TextRender>{tail && (<><span class="text-cobalt-ink">.</span><TextRender>{tail}</TextRender></>)}
        </span>
        <span aria-hidden="true">/</span>
        <span>rev. {rev}</span>
        {commit && (<><span aria-hidden="true">/</span><span>{commit}</span></>)}
        <span aria-hidden="true">/</span>
        {/* Filled in by the script below. Ships with the build date already in
            it, so a reader with JavaScript off sees a real fact rather than an
            empty slot or a dash. */}
        <span>
          up <time id="site-uptime" datetime={builtAt}>sinds {new Date(builtAt).toISOString().slice(0, 10)}</time>
        </span>
        <span aria-hidden="true">/</span>
        <span>&copy; {new Date().getFullYear()} <TextRender>{copyrightText || wordmark}</TextRender></span>
      </div>

      {
        socials.length > 0 && (
          <div class="flex gap-5">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-mutedText transition-colors duration-200 hover:text-primaryText"
              >
                <span class="sr-only">{s.label}</span>
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d={s.path} />
                </svg>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</footer>

{/* `is:inline` is explicit rather than implied: `define:vars` forces it
    anyway, and stating it keeps the build from warning that this script is
    unprocessed every time anyone runs `astro check`. */}
<script is:inline define:vars={{ builtAt }}>
  // Uptime since this build went out. Counted in the reader's browser from the
  // build stamp, so it is the genuine article rather than a number ticking up
  // from an invented launch date.
  //
  // Updates once a minute: anything finer would be a stopwatch, and a footer
  // is not a status page. Wrapped, because a footer flourish must never be the
  // thing that takes an inline script down.
  (function () {
    try {
      var el = document.getElementById("site-uptime");
      if (!el) return;

      var since = new Date(builtAt).getTime();
      if (!isFinite(since)) return;

      var render = function () {
        var secs = Math.max(0, (Date.now() - since) / 1000);
        var d = Math.floor(secs / 86400);
        var h = Math.floor((secs % 86400) / 3600);
        var m = Math.floor((secs % 3600) / 60);
        el.textContent = d > 0 ? d + "d " + h + "h" : h > 0 ? h + "h " + m + "m" : m + "m";
      };

      render();
      setInterval(render, 60000);
    } catch (e) {
      /* leave the build date in place */
    }
  })();
</script>

{/* The view-source easter egg. Costs nothing, ships in the HTML, and rewards
    exactly the kind of person who reads the HTML.

    The address below is spelled out rather than written plainly, and that is
    not decoration: the email-obscurer integration rewrites addresses in text
    nodes and in `href="mailto:"`, but its text pass matches `>...<`, so
    nothing inside an HTML comment is ever reached. A real address here would
    be the one un-obscured copy on the whole site, sitting in the markup of
    every single page. */}
