---
/**
 * @component AmbientWash
 * @version   1.1.0
 * @updated   2026-09-11
 *
 * Soft colour drifting behind a section, like light falling across the page.
 *
 * This is the one place the site's palette appears as colour rather than as a
 * mark, and it is kept honest by three rules:
 *
 *   - It is always behind something. A wash on an empty band is a gradient
 *     background, which is the generated-portfolio look; a wash behind a
 *     photograph is lighting.
 *   - It never carries meaning and never sits under body copy at strength.
 *     `strong` is for the hero, where the only things over it are a headline
 *     and a cut-out figure. `faint` is for everywhere else.
 *   - It moves on a scale of minutes. See the keyframes in the Tailwind config:
 *     the three periods are 83s, 107s and 131s, which is slow enough that you
 *     notice it only by looking away and back.
 *   - The animation is behind `motion-safe:`, and that prefix is load-bearing.
 *     A bare `animate-wash-a` keeps running under
 *     `prefers-reduced-motion: reduce`, because the default
 *     `animation-play-state` is already `running` — pairing it with a
 *     `motion-safe:[animation-play-state:running]` utility, as this first did,
 *     changes nothing at all. The variant has to sit on the `animate-*` class
 *     itself so the animation is never declared in the first place.
 *
 * ---------------------------------------------------------------------------
 * IT NO LONGER TINTS THE HERO PORTRAIT.
 *
 * It used to, and the note that said so was right at the time: the portrait
 * was a JPEG on a white backdrop composited with `mix-blend-mode: multiply`,
 * which meant it took the colour of whatever was behind it — peach around the
 * shoulders, grey at the head. The portrait is now a real cut-out with an
 * alpha channel and no blend mode, so it keeps its own black and white and the
 * wash is what it always claimed to be: light behind the figure.
 *
 * That removes the trap this section used to carry (a blurred ancestor formed
 * a stacking context and collapsed the cut-out into a white box) and it
 * removes the ceiling on how dark a wash could go before it stained him. The
 * layers below are still deliberately light, but now for the ordinary reason:
 * at strength they stop reading as light on paper and start reading as a
 * coloured background with a photograph on it.
 * ---------------------------------------------------------------------------
 */

export interface Props {
  /** `strong` behind the hero portrait; `faint` for a section that just needs
   *  its flatness broken. */
  intensity?: "strong" | "faint";
  class?: string;
}

const { intensity = "faint", class: extraClass = "" } = Astro.props;

const strong = intensity === "strong";

/**
 * The three layers.
 *
 * Warm first and lowest, because that is where the reference puts its light —
 * low and to the centre, under the figure. The cool one sits high and opposite
 * so the band reads as two light sources rather than as one coloured smear.
 *
 * Complete class literals: Tailwind cannot see a name assembled at runtime.
 *
 * The opacities are bracketed (`bg-amber/[0.26]`, not `bg-amber/26`) and have
 * to stay that way. Tailwind only generates a slash-opacity utility for values
 * that are ON its opacity scale — 5, 10, 20, 25, 30, 40, 50, 60, 70, 75, 80,
 * 90, 95, 100 — and emits absolutely nothing for anything else. No warning, no
 * build error: the class lands in the HTML, no rule is ever written, and the
 * layer renders fully transparent. Two of these three washes were invisible
 * for exactly that reason before this note existed.
 */
const layers = strong
  ? [
      // Amber, wide and LOW. Deliberately an ellipse rather than a circle and
      // wide enough to run the full width of the band: the warmth has to carry
      // on behind the figure, not stop beside it, or only the empty half of
      // the hero is lit and the light reads as a shape rather than as light.
      //
      // It sits low because the silver has to win the top two-thirds. The band
      // should read as light gathering at the foot of the page, not as a
      // coloured background with a photograph on it.
      "left-[-8%] top-[52%] h-[46rem] w-[85%] bg-amber/[0.17] motion-safe:animate-wash-a",
      // Tomato, centred behind the figure, where it warms the page around his
      // shoulders — which is where the eye already is. Kept lighter than the
      // amber: two warm layers at strength stop being two light sources and
      // become one flat orange field.
      "left-[34%] top-[58%] h-[42rem] w-[60%] bg-tomato/[0.12] motion-safe:animate-wash-b",
      // Cobalt, high and right. A cool counterweight; without it the band
      // slides into a sunset, which is a different and much cheaper look.
      "right-[-14%] top-[-30%] h-[42rem] w-[55%] bg-cobalt/[0.10] motion-safe:animate-wash-c",
    ]
  : [
      "left-[-10%] top-[-30%] h-[34rem] w-[45%] bg-cobalt/[0.07] motion-safe:animate-wash-c",
      "right-[-12%] bottom-[-40%] h-[32rem] w-[42%] bg-amber/[0.09] motion-safe:animate-wash-a",
    ];

---

{/* `overflow-hidden` keeps the blur from bleeding past the section edge, which
    would tint the band above or below it. */}
<div
  class:list={["pointer-events-none absolute inset-0 overflow-hidden", extraClass]}
  aria-hidden="true"
  data-wash
>
  {
    layers.map((layer) => (
      <div
        class:list={[
          "absolute rounded-full will-change-transform",
          strong ? "blur-[130px]" : "blur-[130px]",
          layer,
        ]}
        data-wash-layer
      />
    ))
  }
</div>

<script>
  // Park the washes while their section is off-screen.
  //
  // They are cheap — transform-only, so the compositor handles them without a
  // repaint — but "cheap and permanent" is still a frame every 16ms for a
  // reader who has scrolled well past them, and on a laptop that is battery.
  //
  // Purely an optimisation: if this never runs, the washes simply keep
  // animating, which is the behaviour without it anyway. It also deliberately
  // does not start anything — `motion-safe:` in the CSS is what decides whether
  // these move at all, and this must not override someone's reduced-motion
  // preference by resuming an animation that should never have played.
  (() => {
    const washes = document.querySelectorAll<HTMLElement>("[data-wash]");
    if (!washes.length || !("IntersectionObserver" in window)) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const layers = entry.target.querySelectorAll<HTMLElement>("[data-wash-layer]");
          layers.forEach((el) => {
            el.style.animationPlayState = entry.isIntersecting ? "" : "paused";
          });
        }
      },
      { threshold: 0 },
    );

    washes.forEach((w) => io.observe(w));
  })();
</script>
