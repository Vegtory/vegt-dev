---
/**
 * @component PhotoInterrupt
 * @version   1.0.0
 * @updated   2026-09-11
 *
 * One photograph, full width, interrupting the technical content.
 *
 * This is a rhythm device rather than a gallery. Three cards of software, then
 * a picture that has nothing to do with software, then software again — which
 * is what stops the page reading as a portfolio and starts it reading as a
 * person who also does other things. The photography on this site is
 * substantial enough to deserve better than a "hobbies" footnote, and this is
 * how it gets to interrupt rather than to be filed.
 *
 * The caption is set as a source comment, which is one of the site's small
 * jokes and is rationed accordingly.
 *
 * On what the caption may say: the gallery JPEGs were exported with EXIF
 * stripped, so there is no shutter speed or aperture to read out of them. The
 * caption therefore carries place and date only. Writing "1/250 · f/2.8"
 * under a photograph whose actual settings nobody knows would make the page
 * lie about the one thing it is showing.
 */
import type { ImageMetadata } from "astro";
import CustomPicture from "@ui/CustomPicture.astro";
import MetaLine from "@ui/MetaLine.astro";
import Annotation from "@ui/Annotation.astro";

export interface ImageItem {
  image: ImageMetadata | string;
  description?: string;
  subText?: string;
}

export interface Props {
  imageItem: ImageItem;
  captionMeta?: string[];
  note?: string;
}

const { imageItem, captionMeta = [], note = "" } = Astro.props;
---

<section class="bg-background pb-12 pt-4 sm:pb-16">
  {/* Breaks the page's own measure: the figure runs to the viewport edge on
      wide screens while every other section stops at max-w-6xl. One element
      on the homepage does this, which is what makes it land. */}
  <figure class="mx-auto max-w-[110rem] px-6 lg:px-8" data-reveal>
    {/* 2:1 rather than a wider cinematic crop: the gallery originals sit
        between 1.4 and 2.0, so anything wider starts cutting the top and
        bottom out of the photograph to fit the layout. The picture wins. */}
    <CustomPicture
      alt={imageItem.description}
      classes="w-full aspect-[2/1]"
      sizes="(min-width: 1760px) 1696px, calc(100vw - 3rem)"
      srcImagePath={imageItem.image}
      loading="lazy"
    />

    {/* No inner measure on the caption: it has to start at the photograph's
        own left edge, and this figure is deliberately wider than the page's
        max-w-6xl. Constraining it here indented the caption away from the
        picture it belongs to. */}
    <figcaption class="mt-4 flex flex-wrap items-start justify-between gap-4">
      <MetaLine items={captionMeta} shape="comment" />
      {note && <Annotation tone="note" tilt={-1}>{note}</Annotation>}
    </figcaption>
  </figure>
</section>
