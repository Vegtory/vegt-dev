---
/**
 * @component Header
 * @version   2.0.0
 * @updated   2026-09-11
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * Paper bar, hairline underneath, conventional navigation.
 *
 * The navigation is deliberately ordinary — labels, in a row, in the place
 * every other site puts them. People arrive carrying conventions from every
 * site they have ever used, and spending that goodwill on a clever nav buys
 * nothing: the identity here is meant to come from the typography, the marks
 * and the photographs, none of which require the reader to relearn where the
 * links are.
 *
 * Changed from the previous version: the dark `ink-950` bar and its blinking
 * terminal caret are gone. The bar is paper now, and only gains a rule and a
 * faint shadow once content scrolls under it. The wordmark keeps one piece of
 * colour — a cobalt full stop — which is the site's whole logo.
 */
import TextRender from "@ui/TextRender.astro";
import Button from "@ui/Button.astro";

export interface HeaderLink {
  label: string;
  link: string;
}

export interface Props {
  wordmark?: string;
  links?: readonly HeaderLink[];
  /** The one call to action, rendered as a button. Omit for none. */
  cta?: { label: string; link: string };
}

const { wordmark = "", links = [], cta } = Astro.props;

/**
 * Split the wordmark on its dot so the separator can be coloured. Falls back
 * to rendering the string whole, so a wordmark without a dot still works.
 */
const dot = wordmark.indexOf(".");
const head = dot > -1 ? wordmark.slice(0, dot) : wordmark;
const tail = dot > -1 ? wordmark.slice(dot + 1) : "";
---

{/* Given a real 1px height and pulled back out of flow with -mb-px: a
   zero-area target is not reliably reported as intersecting. */}
<div id="header-sentinel" class="h-px -mb-px" aria-hidden="true"></div>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-background/90 backdrop-blur-md transition-colors duration-300"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4 lg:px-8"
    aria-label="Hoofdnavigatie"
  >
    <a
      href="/"
      class="font-mono text-base font-semibold tracking-tight text-primaryText no-underline"
    >
      <TextRender>{head}</TextRender>{
        tail && (
          <>
            {/* The site's only logo: one cobalt full stop. */}
            <span class="text-cobalt">.</span>
            <TextRender>{tail}</TextRender>
          </>
        )
      }
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {
        links.map((t) => (
          <a
            href={t.link}
            class="group relative text-sm font-medium text-mutedText no-underline transition-colors hover:text-primaryText"
          >
            <TextRender>{t.label}</TextRender>
            <span
              class="absolute -bottom-1.5 left-0 h-px w-full origin-left scale-x-0 bg-ink-950 transition-transform duration-300 ease-out group-hover:scale-x-100"
              aria-hidden="true"
            />
          </a>
        ))
      }
      {
        cta && (
          <Button href={cta.link} variant="secondary">
            <TextRender>{cta.label}</TextRender>
          </Button>
        )
      }
    </div>

    <button
      type="button"
      class="-m-2.5 inline-flex items-center justify-center rounded p-2.5 text-mutedText transition-colors hover:text-primaryText lg:hidden"
      id="open-menu-btn"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Open menu</span>
      <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>
    </button>
  </nav>
</header>

<!-- Mobile drawer. It is a SIBLING of <header>, not a child, and must stay
   one: the header carries `backdrop-blur-md`, and a backdrop-filter makes an
   element the containing block for `position: fixed` descendants. Nested
   inside, the drawer's `inset-y-0` panel resolved against the 56px header
   instead of the viewport, so it opened as a letterbox with its links
   clipped. -->
<div class="hidden lg:hidden" role="dialog" aria-modal="true" aria-label="Menu" id="mobile-menu">
  <div class="fixed inset-0 z-40 bg-ink-950/40 backdrop-blur-sm" data-menu-close></div>
  <div class="fixed inset-y-0 right-0 z-50 w-full max-w-sm overflow-y-auto border-l border-hairline bg-background px-6 py-4">
    <div class="flex items-center justify-between">
      <span class="font-mono text-base font-semibold text-primaryText">
        <TextRender>{head}</TextRender>{tail && (<><span class="text-cobalt">.</span><TextRender>{tail}</TextRender></>)}
      </span>
      <button
        type="button"
        class="-m-2.5 rounded p-2.5 text-mutedText transition-colors hover:text-primaryText"
        data-menu-close
      >
        <span class="sr-only">Sluit menu</span>
        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="mt-8 flex flex-col">
      {
        links.map((t) => (
          <a
            href={t.link}
            data-menu-close
            class="border-b border-hairline py-3.5 text-base font-medium text-primaryText no-underline transition-colors hover:text-cobalt-ink"
          >
            <TextRender>{t.label}</TextRender>
          </a>
        ))
      }
      {
        cta && (
          <Button href={cta.link} variant="primary" class="mt-6 justify-center" data-menu-close>
            <TextRender>{cta.label}</TextRender>
          </Button>
        )
      }
    </div>
  </div>
</div>

<script>
  // Add the rule under the bar once anything has scrolled beneath it. A
  // sentinel is cheaper than a scroll listener: no handler runs per frame,
  // the browser just reports the two crossings.
  const sentinel = document.getElementById("header-sentinel");
  const siteHeader = document.getElementById("site-header");

  if (sentinel && siteHeader && "IntersectionObserver" in window) {
    new IntersectionObserver(
      ([entry]) => {
        const stuck = !entry.isIntersecting;
        siteHeader.classList.toggle("border-hairline", stuck);
        siteHeader.classList.toggle("border-transparent", !stuck);
      },
      { threshold: 0 },
    ).observe(sentinel);
  }

  const openBtn = document.getElementById("open-menu-btn");
  const menu = document.getElementById("mobile-menu");

  // A page may render the header without the drawer; bail rather than
  // throwing and taking every other inline script on the page down with us.
  if (openBtn && menu) {
    const setOpen = (isOpen: boolean) => {
      menu.classList.toggle("hidden", !isOpen);
      openBtn.setAttribute("aria-expanded", String(isOpen));
      // Stops the page behind the drawer from scrolling with it.
      document.documentElement.classList.toggle("overflow-hidden", isOpen);
    };

    openBtn.addEventListener("click", () => setOpen(true));

    // Covers the close button, the backdrop, and every link in the drawer, so
    // an in-page anchor does not leave the menu covering what it jumped to.
    menu.querySelectorAll("[data-menu-close]").forEach((el) =>
      el.addEventListener("click", () => setOpen(false)),
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) setOpen(false);
    });
  }
</script>
