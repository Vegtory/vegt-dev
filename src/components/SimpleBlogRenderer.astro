---
/**
 * @component SimpleBlogRenderer
 * @version   2.0.0
 * @updated   2026-09-11
 * @source    astro-template@0ad4fd0
 * @copied    2026-09-10
 * @modified  true
 *
 * The SCHRIJVEN section: the three most recent posts.
 *
 * Restyled as index entries rather than as cards — a hairline lattice, mono
 * dates, the topic carried by a pad rather than a coloured label. The first
 * entry takes the full width with a wider image, because three identical
 * tiles is the single most generated-looking row on the internet and this page
 * has spent the rest of its length avoiding exactly that.
 */
import { getCollection } from "astro:content";
import CustomPicture from "@ui/CustomPicture.astro";
import TextRender from "@ui/TextRender.astro";
import SectionHeading from "@ui/SectionHeading.astro";
import Button from "@ui/Button.astro";
import { formatDate } from "@ui/date";
import { proseBase } from "@ui/prose";
import { topicFor } from "@ui/topics";

export interface Props {
  title?: string;
  subtitle?: string;
  topic?: string;
  index?: string;
}

const { title = "", subtitle = "", topic, index = "" } = Astro.props;

const allBlogs = await getCollection("blog");
const posts = allBlogs
  .filter(({ data }) => !data.ishidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<section class="bg-background py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading topic={topic} eyebrow={subtitle} title={title} index={index} />
      <Button href="/blog" variant="inline" class="shrink-0">Alle notities</Button>
    </div>

    {/* The measure lives on this wrapper, not on the prose element: the
        `max-w-none` inside `proseBase` is there so typography does not impose
        its own width, and two max-width utilities on one element resolve by
        stylesheet order rather than by which one you meant. */}
    <div class="mt-8 max-w-2xl" data-reveal style="--reveal-delay: 90ms">
      <div class={proseBase}><slot /></div>
    </div>

    <div class="mt-12 border-t border-hairline">
      {
        posts.map(({ id, data }, i) => {
          const postTopic = topicFor(data.topic);
          // The first entry is the lead: wider image, larger heading.
          const lead = i === 0;
          return (
            <article
              data-reveal
              style={`--reveal-delay: ${i * 90}ms`}
              class="group relative flex flex-col gap-5 border-b border-hairline py-7 transition-colors hover:bg-surfaceMuted sm:flex-row sm:items-start sm:gap-8"
            >
              <div class:list={["w-full shrink-0", lead ? "sm:w-72" : "sm:w-44"]}>
                <CustomPicture
                  alt={data.description}
                  classes={lead ? "aspect-[16/9] w-full" : "aspect-[4/3] w-full"}
                  sizes={lead ? "(min-width: 640px) 288px, calc(100vw - 3rem)" : "(min-width: 640px) 176px, calc(100vw - 3rem)"}
                  srcImagePath={data.imageItem.image}
                  loading="lazy"
                />
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[0.6875rem] text-mutedText">
                  <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
                  {postTopic && (
                    <>
                      <span class="text-hairlineStrong" aria-hidden="true">·</span>
                      <span class="inline-flex items-center gap-1.5">
                        {/* The pad carries the colour; the label stays ink.
                            Two of the five marks are too light to set type
                            in, so no topic ever colours its own label. */}
                        <span class:list={["h-1.5 w-1.5", postTopic.mark]} aria-hidden="true" />
                        {postTopic.id}
                      </span>
                    </>
                  )}
                </div>

                <h3
                  class:list={[
                    "mt-2.5 font-semibold leading-snug tracking-[-0.01em] text-primaryText",
                    lead ? "text-xl sm:text-2xl" : "text-lg",
                  ]}
                >
                  <a href={`/blog/${id}`} class="no-underline focus:outline-none">
                    {/* Stretches the anchor over the whole row. */}
                    <span class="absolute inset-0" aria-hidden="true" />
                    <TextRender>{data.title}</TextRender>
                  </a>
                </h3>

                <p class="mt-2.5 line-clamp-2 max-w-2xl text-sm leading-relaxed text-mutedText">
                  <TextRender>{data.description}</TextRender>
                </p>
              </div>

              <span
                class="hidden shrink-0 self-center text-hairlineStrong transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primaryText sm:block"
                aria-hidden="true"
              >
                →
              </span>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
