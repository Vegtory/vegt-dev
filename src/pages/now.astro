---
/**
 * /now — what William is actually doing at the moment.
 *
 * The convention (nownownow.com) is a page that answers "what are you focused
 * on now?" rather than "what have you done?". It earns its place here because
 * this particular person's list is genuinely varied: the same page carries
 * distributed systems, a bracket that did not need printing, and whatever is
 * in the camera bag.
 *
 * THE ONE RULE FOR THIS PAGE: it has a date on it, and the date is the point.
 * A /now page that has not moved in a year is worse than no /now page, because
 * it advertises exactly how long ago you stopped updating it. `updated` below
 * is the only thing that has to change when the entries do — and the page
 * renders how long ago that was, in plain words, so a stale one says so itself
 * rather than quietly looking current.
 *
 * The entries are ordinary content, held here rather than in a collection
 * because there is exactly one of this page and a schema for a single file is
 * ceremony without a payoff.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "@ui/SiteHeader.astro";
import SiteFooter from "@ui/SiteFooter.astro";
import SectionHeading from "@ui/SectionHeading.astro";
import Connector from "@ui/Connector.astro";
import Annotation from "@ui/Annotation.astro";
import MetaLine from "@ui/MetaLine.astro";
import Button from "@ui/Button.astro";
import { formatDate } from "@ui/date";
import { site } from "../site";

/** Change this whenever the entries below change. Nothing else tracks it. */
const updated = new Date("2026-09-11");

/**
 * The list. `mark` is the pad colour beside each heading — incidental, tied to
 * the topic vocabulary where one applies. Complete literals, because Tailwind
 * cannot see a runtime-assembled class name.
 */
const entries: { label: string; mark: string; lines: string[] }[] = [
  {
    label: "Bouwen",
    mark: "bg-cobalt",
    lines: [
      "Gedistribueerde systemen, overdag.",
      "Kleine tools die één ding doen, 's avonds.",
      "hillchart.dev blijft af en toe een zetje krijgen.",
    ],
  },
  {
    label: "Leren",
    mark: "bg-violet",
    lines: [
      "Hoe je een systeem zó opdeelt dat het later niet tegen je werkt.",
      "Genoeg elektronica om het niet te slopen.",
    ],
  },
  {
    label: "Draait thuis",
    mark: "bg-amber",
    lines: [
      "Home Assistant, als spin in het web.",
      "Ventilatie die naar een automatisering luistert.",
      "Een omvormer die via Modbus zijn cijfers afstaat.",
    ],
  },
  {
    label: "In de cameratas",
    mark: "bg-tomato",
    lines: [
      "Een body, twee lenzen, en meestal de verkeerde erop.",
    ],
  },
  {
    label: "Laatst geprint",
    mark: "bg-acid",
    lines: [
      "Weer een beugeltje.",
      "Het past. Dat is het belangrijkste.",
    ],
  },
];

/** "3 maanden geleden", from the date above. Keeps a stale page honest. */
function agoInWords(from: Date): string {
  const days = Math.floor((Date.now() - from.getTime()) / 86_400_000);
  if (days <= 1) return "vandaag bijgewerkt";
  if (days < 14) return `${days} dagen geleden bijgewerkt`;
  if (days < 60) return `${Math.floor(days / 7)} weken geleden bijgewerkt`;
  return `${Math.floor(days / 30)} maanden geleden bijgewerkt`;
}
---

<BaseLayout
  title="Nu — William van der Vegt"
  description="Waar ik op dit moment mee bezig ben: bouwen, leren, wat er thuis draait, wat er in de cameratas zit en wat er laatst geprint is."
  keywords="now page, nu, William van der Vegt, homelab, projecten"
  lang={site.lang}
  locale={site.locale}
  umamiId={site.umamiId}
>
  <SiteHeader />

  <main class="bg-background">
    <div class="mx-auto max-w-3xl px-6 pb-24 pt-14 sm:px-8">
      <SectionHeading eyebrow="Nu" title="Waar ik op dit moment mee bezig ben" as="h1">
        <p class="mt-6 leading-relaxed text-mutedText">
          Geen archief en geen cv — alleen wat er op dit moment speelt. Zodra
          het niet meer klopt, hoort het hier weg.
        </p>
      </SectionHeading>

      <div class="mt-8">
        <MetaLine
          items={[formatDate(updated), agoInWords(updated)]}
          shape="comment"
        />
      </div>

      <Connector class="mt-12" tone="hairline" />

      <dl class="mt-4">
        {
          entries.map((entry, i) => (
            <div
              class="grid grid-cols-1 gap-2 border-b border-hairline py-7 sm:grid-cols-3 sm:gap-8"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <dt class="flex items-center gap-2.5 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-primaryText">
                <span class:list={["h-1.5 w-1.5 shrink-0", entry.mark]} aria-hidden="true" />
                {entry.label}
              </dt>
              <dd class="sm:col-span-2">
                <ul class="flex flex-col gap-1.5">
                  {entry.lines.map((line) => (
                    <li class="leading-relaxed text-blackText">{line}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 flex flex-wrap items-start justify-between gap-8">
        <Button href="/#over" variant="secondary" arrow>
          Wat ik verder doe
        </Button>

        <Annotation arrow="left-up" tone="note" tilt={-2}>
          Een pagina die niet bijgewerkt wordt, vertelt vooral dat.
        </Annotation>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
