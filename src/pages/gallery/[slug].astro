---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryLightbox from '@ui/GalleryLightbox.astro';
import CustomPicture from '@ui/CustomPicture.astro';
import SiteHeader from '@ui/SiteHeader.astro';
import SiteFooter from '@ui/SiteFooter.astro';
import { formatDate } from '@ui/date';
import { site } from '../../site';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const albums = await getCollection('gallery');
  return albums.map((album) => ({
    params: { slug: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);

const images = Object.entries(allImages)
  .filter(([path]) => path.startsWith(`/src/assets/gallery/${album.id}/`))
  .map(([path, mod]) => ({
    metadata: mod.default,
    alt: `${album.data.title} foto`,
    filename: path.split('/').pop() ?? '',
  }))
  .sort((a, b) => a.filename.localeCompare(b.filename));

const formattedDate = formatDate(album.data.date);

---

<BaseLayout
  title={`${album.data.title} — Foto's`}
  description={album.data.description ?? `Fotogallerij: ${album.data.title}`}
  keywords={`foto, gallerij, ${album.data.title}`}
  lang={site.lang}
  locale={site.locale}
  umamiId={site.umamiId}
>
  <SiteHeader />

  <main class="min-h-screen bg-background">
    <div class="mx-auto max-w-7xl px-6 pb-24 pt-12 sm:px-8">
      <!-- Back link -->
      <a
        href="/gallery"
        class="group mb-8 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 no-underline transition-colors hover:text-primary-700"
      >
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Alle albums
      </a>

      <!-- Album header -->
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-primaryText leading-tight">
          {album.data.title}
        </h1>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-mutedText">
          <time datetime={album.data.date.toISOString()}>
            {formattedDate}
          </time>
          <span aria-hidden="true">·</span>
          <span>{images.length} foto{images.length !== 1 ? "'s" : ''}</span>
          {album.data.description && (
            <>
              <span aria-hidden="true">·</span>
              <span>{album.data.description}</span>
            </>
          )}
        </div>
      </div>

      <!-- Masonry grid -->
      {images.length > 0 ? (
        <div class="columns-2 lg:columns-3 gap-2">
          {images.map((img, idx) => (
            <button
              class="break-inside-avoid mb-2 w-full block focus:outline-none focus:ring-2 focus:ring-primary-600 rounded-xl overflow-hidden group"
              data-lightbox-trigger
              data-album={album.id}
              data-index={String(idx)}
              aria-label={`Open foto ${idx + 1}`}
              type="button"
            >
              <div class="group-hover:opacity-90 transition-opacity duration-200">
                <CustomPicture
                  srcImagePath={img.metadata}
                  alt={img.alt}
                  classes="w-full rounded-xl"
                  sizes="(min-width: 1024px) 33vw, 50vw"
                  loading={idx < 6 ? 'eager' : 'lazy'}
                />
              </div>
            </button>
          ))}
        </div>
      ) : (
        <div class="py-24 text-center text-mutedText">
          <svg class="w-16 h-16 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-sm">Geen foto's gevonden voor dit album.</p>
          <p class="text-xs mt-2">
            Voeg foto's toe aan{' '}
            <code class="rounded bg-surfaceMuted px-1 font-mono">
              src/assets/gallery/{album.id}/
            </code>
          </p>
        </div>
      )}
    </div>
  </main>

  <SiteFooter />

  <GalleryLightbox albums={[{ slug: album.id, images }]} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const albumSlug = btn.dataset.album!;
      const index = parseInt(btn.dataset.index ?? '0', 10);
      window.dispatchEvent(new CustomEvent('gallery:open', { detail: { albumSlug, index } }));
    });
  });
</script>
