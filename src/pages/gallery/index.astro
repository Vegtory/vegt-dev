---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryLightbox from '@ui/GalleryLightbox.astro';
import CustomPicture from '@ui/CustomPicture.astro';
import SiteHeader from '@ui/SiteHeader.astro';
import SiteFooter from '@ui/SiteFooter.astro';
import SectionHeading from '@ui/SectionHeading.astro';
import { formatDate, formatMonth } from '@ui/date';
import { site } from '../../site';
import type { ImageMetadata } from 'astro';

const albums = await getCollection('gallery');
const sortedAlbums = albums.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);

const albumData = sortedAlbums.map((album) => {
  const slug = album.id;
  const images = Object.entries(allImages)
    .filter(([path]) => path.startsWith(`/src/assets/gallery/${slug}/`))
    .map(([path, mod]) => ({
      metadata: mod.default,
      alt: `${album.data.title} foto`,
      filename: path.split('/').pop() ?? '',
    }))
    .sort((a, b) => a.filename.localeCompare(b.filename));
  return { album, images };
});
---

<BaseLayout
  title="Foto's — William van der Vegt"
  description="Fotogallerij"
  keywords="foto, gallerij, fotografie, albums"
  lang={site.lang}
  locale={site.locale}
  umamiId={site.umamiId}
>
  <SiteHeader />

  <main class="min-h-screen bg-background">
    <div class="mx-auto max-w-7xl px-6 pt-12 sm:px-8">
      <SectionHeading topic="shoot" title="Foto&apos;s" as="h1" />

      <!-- Album picker, mobile only; the sidebar covers this on desktop. -->
      <div class="mt-6 lg:hidden">
        <select
          id="mobile-album-select"
          class="w-full rounded border border-hairline bg-surface px-3 py-2 text-sm text-primaryText focus:outline-none focus:ring-2 focus:ring-ink-950"
          aria-label="Spring naar album"
        >
          {albumData.map(({ album }) => (
            <option value={album.id}>
              {album.data.title} — {formatMonth(album.data.date)}
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="max-w-7xl mx-auto flex gap-8 px-6 sm:px-8 pt-10">
      <!-- Sticky sidebar (desktop) -->
      <aside class="hidden lg:block w-52 shrink-0">
        <div class="sticky top-24 pt-2">
          <p class="mb-3 px-3 font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-mutedText">
            Albums
          </p>
          <nav class="space-y-0.5" id="album-nav">
            {albumData.map(({ album, images }) => (
              <a
                href={`#${album.id}`}
                class="album-nav-link group flex items-center justify-between rounded-lg px-3 py-2 text-sm text-mutedText no-underline transition-colors hover:bg-surfaceMuted hover:text-primaryText"
                data-album={album.id}
              >
                <span class="flex flex-col min-w-0">
                  <span class="truncate font-medium">{album.data.title}</span>
                  <span class="font-mono text-[10px] tabular-nums text-mutedText">
                    {formatMonth(album.data.date)}
                  </span>
                </span>
                <span class="ml-1 shrink-0 font-mono text-xs text-mutedText">
                  {images.length}
                </span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main scroll content -->
      <div class="flex-1 min-w-0 pb-24">
        {albumData.map(({ album, images }) => (
          <section id={album.id} class="mb-24 scroll-mt-16">
            <!-- Album header -->
            <div class="mb-5 flex items-start justify-between gap-4 border-b border-hairline pb-4">
              <div>
                <h2 class="text-xl sm:text-2xl font-semibold tracking-[-0.015em] text-primaryText leading-tight">
                  {album.data.title}
                </h2>
                <div class="mt-1.5 flex flex-wrap items-center gap-2 text-sm text-mutedText">
                  <time datetime={album.data.date.toISOString()}>
                    {formatDate(album.data.date)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{images.length} foto{images.length !== 1 ? "'s" : ''}</span>
                  {album.data.description && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span>{album.data.description}</span>
                    </>
                  )}
                </div>
              </div>
              <a
                href={`/gallery/${album.id}`}
                class="mt-1 shrink-0 font-mono text-xs text-mutedText no-underline transition-colors hover:text-primaryText"
              >
                Bekijk album →
              </a>
            </div>

            <!-- Masonry grid -->
            {images.length > 0 ? (
              <div class="columns-2 lg:columns-3 gap-2">
                {images.map((img, idx) => (
                  <button
                    class="break-inside-avoid mb-2 w-full block focus:outline-none focus:ring-2 focus:ring-ink-950 overflow-hidden group"
                    data-lightbox-trigger
                    data-album={album.id}
                    data-index={String(idx)}
                    aria-label={`Open foto ${idx + 1} van ${album.data.title}`}
                    type="button"
                  >
                    <div class="group-hover:opacity-90 transition-opacity duration-200">
                      <CustomPicture
                        srcImagePath={img.metadata}
                        alt={img.alt}
                        classes="w-full"
                        sizes="(min-width: 1024px) 33vw, 50vw"
                        loading="lazy"
                      />
                    </div>
                  </button>
                ))}
              </div>
            ) : (
              <p class="py-8 text-center text-sm italic text-mutedText">
                Geen foto's gevonden voor dit album.
                <br />
                <span class="text-xs">
                  Voeg foto's toe aan{' '}
                  <code class="rounded bg-surfaceMuted px-1 font-mono">
                    src/assets/gallery/{album.id}/
                  </code>
                </span>
              </p>
            )}
          </section>
        ))}

        {albumData.length === 0 && (
          <div class="py-24 text-center text-mutedText">
            <svg class="w-16 h-16 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm">Geen albums gevonden.</p>
          </div>
        )}
      </div>
    </div>
  </main>

  <SiteFooter />

  <GalleryLightbox albums={albumData.map(({ album, images }) => ({ slug: album.id, images }))} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const albumSlug = btn.dataset.album!;
      const index = parseInt(btn.dataset.index ?? '0', 10);
      window.dispatchEvent(new CustomEvent('gallery:open', { detail: { albumSlug, index } }));
    });
  });

  document.getElementById('mobile-album-select')?.addEventListener('change', (e) => {
    const slug = (e.target as HTMLSelectElement).value;
    document.getElementById(slug)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.album-nav-link');
  if (navLinks.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const slug = entry.target.id;
            navLinks.forEach((link) => {
              const isActive = link.dataset.album === slug;
              link.classList.toggle('bg-surfaceMuted', isActive);
              link.classList.toggle('text-primaryText', isActive);
              link.classList.toggle('font-semibold', isActive);
            });
          }
        }
      },
      { threshold: 0.15, rootMargin: '-10% 0px -75% 0px' }
    );
    document.querySelectorAll<HTMLElement>('section[id]').forEach((s) => observer.observe(s));
  }
</script>
