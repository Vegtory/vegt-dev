---
import { getEntry, render, type CollectionEntry } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import { mdxComponents } from "../components/mdxComponents";
import { site } from "../site";

import SiteHeader from "@ui/SiteHeader.astro";
import Hero from "@ui/Hero.astro";
import TopicStrip from "@ui/TopicStrip.astro";
import TextWithLargeImage from "@ui/TextWithLargeImage.astro";
import ToolsShowcase from "@ui/ToolsShowcase.astro";
import TinkerGrid from "@ui/TinkerGrid.astro";
import PhotoInterrupt from "@ui/PhotoInterrupt.astro";
import SpeakingFeature from "@ui/SpeakingFeature.astro";
import PhotoCollage from "@ui/PhotoCollage.astro";
import SimpleBlogRenderer from "@ui/SimpleBlogRenderer.astro";
import SiteFooter from "@ui/SiteFooter.astro";

type SectionData = CollectionEntry<"sections">["data"];

/**
 * Load one section by filename and assert its `type`, so a renamed file or a
 * mistyped discriminator fails the build with the path in the message rather
 * than rendering an empty section.
 */
async function section<T extends SectionData["type"]>(id: string, type: T) {
  const entry = await getEntry("sections", id);
  if (!entry) {
    throw new Error(`Missing section content: src/content/sections/${id}.mdx`);
  }
  if (entry.data.type !== type) {
    throw new Error(
      `Section "${id}" has type "${entry.data.type}", expected "${type}".`,
    );
  }
  const { Content } = await render(entry);
  return { data: entry.data as Extract<SectionData, { type: T }>, Content };
}

// `onder-constructie.mdx` is deliberately not composed in. The banner was the
// first thing on the page and it apologised for the site in alarm-red; the
// file stays in the repo so it is one import and one line to put back.
const hero = await section("hero", "hero");
const over = await section("over", "textWithLargeImage");
const tools = await section("tools", "toolsShowcase");
const knutselen = await section("knutselen", "tinkerGrid");
const onderbreking = await section("onderbreking", "photoInterrupt");
const vertellen = await section("vertellen", "speaking");
const fotografie = await section("fotografie", "photoCollage");
const blog = await section("blog", "simpleBlogRenderer");

// Astro cannot render a component from a member expression, so bind the ones
// with body copy to capitalised locals. Only components that declare a <slot/>
// get a body; passing one to the others would silently discard it.
const { Content: OverBody } = over;
const { Content: ToolsBody } = tools;
const { Content: KnutselBody } = knutselen;
const { Content: VertelBody } = vertellen;
const { Content: BlogBody } = blog;
---

<BaseLayout
  title={site.name}
  description="William van der Vegt — software, systemen en dingen die ik waarschijnlijk niet had hoeven bouwen. Cloud, homelab, 3D-printen, meten aan energie en fotografie."
  keywords="software developer, cloud, Azure, C#, homelab, Home Assistant, 3D printen, domotica, fotografie, Nijmegen"
  lang={site.lang}
  locale={site.locale}
  umamiId={site.umamiId}
>
  <SiteHeader />

  <main>
    {/*
      The page is one continuous stream of things William does, rather than a
      portfolio hierarchy with hobbies filed at the bottom. Two deliberate
      properties of the order below:

        - Photography interrupts the technical content instead of following
          it. The full-bleed frame sits between the homelab and the speaking
          section, so the page has a person in it before it asks anyone to
          read about Modbus.
        - The two photographs of William are kept far apart. Portrait at the
          top, talk photo around 60% down; together at the top they would make
          the opening screen a headshot gallery.

      The wrapper ids are the in-page anchor targets used by src/site.ts.
    */}
    <div id="hero"><Hero {...hero.data} /></div>

    <TopicStrip />

    <div id="over">
      <TextWithLargeImage {...over.data}>
        <OverBody components={mdxComponents} />
      </TextWithLargeImage>
    </div>

    <div id="bouwen">
      <ToolsShowcase {...tools.data}>
        <ToolsBody components={mdxComponents} />
      </ToolsShowcase>
    </div>

    <div id="knutselen">
      <TinkerGrid {...knutselen.data}>
        <KnutselBody components={mdxComponents} />
      </TinkerGrid>
    </div>

    <PhotoInterrupt {...onderbreking.data} />

    <div id="vertellen">
      <SpeakingFeature {...vertellen.data}>
        <VertelBody components={mdxComponents} />
      </SpeakingFeature>
    </div>

    <div id="schrijven">
      <SimpleBlogRenderer {...blog.data}>
        <BlogBody components={mdxComponents} />
      </SimpleBlogRenderer>
    </div>

    <div id="fotograferen"><PhotoCollage {...fotografie.data} /></div>
  </main>

  <SiteFooter />
</BaseLayout>
