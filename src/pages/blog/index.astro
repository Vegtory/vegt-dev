---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList from "@ui/BlogList.astro";
import SiteHeader from "@ui/SiteHeader.astro";
import SiteFooter from "@ui/SiteFooter.astro";
import SectionHeading from "@ui/SectionHeading.astro";
import { site } from "../../site";
---

<BaseLayout
  title="Blog — William van der Vegt"
  description="Alles wat ik de moeite van het opschrijven waard vond: cloud, homelab, domotica en meten aan energie."
  keywords="blog, artikelen, cloud, Azure, Home Assistant, homelab, domotica"
  lang={site.lang}
  locale={site.locale}
  umamiId={site.umamiId}
>
  <SiteHeader />

  <main class="bg-background">
    <div class="mx-auto max-w-3xl px-6 pb-24 pt-14 sm:px-8">
      <SectionHeading
        topic="write"
        title="Wat ik tegenkom, opgeschreven"
        as="h1"
      >
        <p class="mt-6 max-w-2xl leading-relaxed text-mutedText">
          Alles wat ik de moeite van het opschrijven waard vond. De artikelen
          zijn in het Engels, zodat ze een breder publiek bereiken.
        </p>
      </SectionHeading>

      <div class="mt-14">
        <BlogList />
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
