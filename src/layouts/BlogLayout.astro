---
/**
 * @component BlogLayout
 * @version   1.0.1
 * @updated   2026-09-10
 * @source    astro-template@10c3958
 * @copied    2026-09-10
 * @modified  true
 *
 * Modified for this site:
 * - Wrapped in the shared header and footer, so an article is not a dead end.
 * - The long inline `prose-*` modifier list moved to `@ui/prose`, which is
 *   what makes an article's links, code and quotes match the homepage.
 * - The uppercase tracked back-link became a normal one; it was the site's
 *   fourth distinct link treatment.
 * - Dates go through `@ui/date` (this hardcoded `en-GB` on a `lang="nl"` site).
 */
import type { ImageMetadata } from "astro";
import CustomPicture from "@ui/CustomPicture.astro";
import SiteHeader from "@ui/SiteHeader.astro";
import SiteFooter from "@ui/SiteFooter.astro";
import { formatDate } from "@ui/date";
import { proseArticle } from "@ui/prose";
import BaseLayout from "./BaseLayout.astro";

export interface ImageItem {
  image: ImageMetadata | string;
  description?: string;
  subText?: string;
}

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  imageItem?: ImageItem;
  date?: Date;
  umamiId?: string;
}

const {
  title = "",
  description = "",
  keywords = "",
  imageItem,
  date,
  umamiId,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  umamiId={umamiId}
>
  <SiteHeader />

  <main class="bg-background">
    <div class="mx-auto max-w-3xl px-6 pb-24 pt-12 sm:px-8">
      <a
        href="/blog"
        class="group inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 no-underline transition-colors hover:text-primary-700"
      >
        <svg
          class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-0.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
        Alle artikelen
      </a>

      <h1 class="mt-8 text-pretty text-3xl font-bold leading-tight tracking-tight text-primaryText sm:text-4xl">
        {title}
      </h1>

      {
        date && (
          <time datetime={date.toISOString()} class="mt-4 block font-mono text-xs text-mutedText">
            {formatDate(date)}
          </time>
        )
      }

      {
        imageItem?.image && (
          <div class="mb-12 mt-8 overflow-hidden rounded-2xl border border-hairline shadow-sm">
            <CustomPicture
              alt={imageItem.description}
              classes="aspect-[16/7] w-full"
              sizes="(min-width: 1040px) 768px, calc(100vw - 3rem)"
              srcImagePath={imageItem.image}
              loading="eager"
            />
          </div>
        )
      }

      <article class:list={["mt-10", proseArticle]}>
        <slot />
      </article>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
