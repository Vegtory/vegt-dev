---
/**
 * @component BlogLayout
 * @version   2.0.1
 * @updated   2026-09-12
 * @source    astro-template@10c3958
 * @copied    2026-09-10
 * @modified  true
 *
 * A single post.
 *
 * Restyled onto the journal tokens: square frames, hairline rules, the topic
 * pad in the metadata line, and the lead image mounted with the same corner
 * registration marks as the hero portrait and the talk photo.
 *
 * The long inline `prose-*` modifier list lives in `@ui/prose`, which is what
 * makes an article's links, code and quotes match the rest of the site.
 */
import type { ImageMetadata } from "astro";
import CustomPicture from "@ui/CustomPicture.astro";
import SiteHeader from "@ui/SiteHeader.astro";
import SiteFooter from "@ui/SiteFooter.astro";
import { formatDate } from "@ui/date";
import { proseArticle } from "@ui/prose";
import { topicFor } from "@ui/topics";
import BaseLayout from "./BaseLayout.astro";

export interface ImageItem {
  image: ImageMetadata | string;
  description?: string;
  subText?: string;
}

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  imageItem?: ImageItem;
  date?: Date;
  topic?: string;
  umamiId?: string;
}

const {
  title = "",
  description = "",
  keywords = "",
  imageItem,
  date,
  topic,
  umamiId,
} = Astro.props;

const postTopic = topicFor(topic);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  umamiId={umamiId}
>
  <SiteHeader />

  <main class="bg-background">
    <div class="mx-auto max-w-3xl px-6 pb-24 pt-14 sm:px-8">
      <a
        href="/blog"
        class="group -mt-1.5 inline-flex items-center gap-1.5 py-1.5 font-mono text-xs text-mutedText no-underline transition-colors hover:text-primaryText"
      >
        <span class="transition-transform duration-200 group-hover:-translate-x-0.5" aria-hidden="true">←</span>
        Alle artikelen
      </a>

      <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[0.6875rem] text-mutedText">
        {
          date && (
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
          )
        }
        {
          postTopic && (
            <>
              <span class="text-hairlineStrong" aria-hidden="true">·</span>
              <span class="inline-flex items-center gap-1.5">
                <span class:list={["h-1.5 w-1.5", postTopic.mark]} aria-hidden="true" />
                {postTopic.id}
              </span>
            </>
          )
        }
      </div>

      <h1 class="mt-4 text-pretty text-3xl font-semibold leading-[1.1] tracking-[-0.025em] text-primaryText sm:text-[2.75rem]">
        {title}
      </h1>

      {
        imageItem?.image && (
          <div class="relative mb-14 mt-10">
            <CustomPicture
              alt={imageItem.description}
              classes="aspect-[16/7] w-full"
              sizes="(min-width: 1040px) 768px, calc(100vw - 3rem)"
              srcImagePath={imageItem.image}
              loading="eager"
            />
            {/* Same mounting as every other photograph on the site. */}
            <span class="absolute -bottom-1 -left-1 h-3 w-3 border-b border-l border-ink-950" aria-hidden="true" />
            <span class="absolute -right-1 -top-1 h-3 w-3 border-r border-t border-ink-950" aria-hidden="true" />
          </div>
        )
      }

      <article class:list={["mt-10", proseArticle]}>
        <slot />
      </article>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
