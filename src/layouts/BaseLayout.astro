---
/**
 * @component BaseLayout
 * @version   1.0.0
 * @updated   2026-09-10
 * @source    astro-template@10c3958
 * @copied    2026-09-10
 * @modified  true
 *
 * Modified: applies the site's font stacks and text colour to <body> so every
 * page inherits them, sets `scroll-padding-top` so an in-page anchor does not
 * land underneath the sticky header, and mounts `ScrollReveal` — which has to
 * be in <head> to take effect before the first paint.
 */
import ScrollReveal from "@ui/ScrollReveal.astro";
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  /** Document language, e.g. "nl" or "en". */
  lang?: string;
  /** Open Graph locale, e.g. "nl_NL". */
  locale?: string;
  /** Umami website id. Omit to ship no analytics at all. */
  umamiId?: string;
  /** Self-hosted Umami host, if you are not on Umami Cloud. */
  umamiHost?: string;
}

const {
  title = "",
  description = "",
  keywords = "",
  ogImage,
  lang = "nl",
  locale = "nl_NL",
  umamiId,
  umamiHost = "https://eu.umami.is",
} = Astro.props;
---

<html lang={lang} class="h-full w-full scroll-smooth [scroll-padding-top:5rem]">
  <head>
    <meta charset="utf-8" />

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="favicon.svg" color="#000000" />
    <link rel="apple-touch-icon" href="apple-favicon.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* The site's only webfont: Caveat, for the pencilled annotations and the
        hero's opening line. Self-hosted, subset, 18 kB.

        The preload and the @font-face belong together and must stay together —
        a preload without a matching rule downloads a file nothing uses, and a
        @font-face without the preload is discovered only after the CSS has
        parsed, which is exactly when it is too late for text above the fold.
        `crossorigin` is required on a font preload even same-origin; without
        it the browser fetches the file twice. */}
    <link
      rel="preload"
      href="/fonts/caveat-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:image" content={ogImage} />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style is:global>
      /* `swap` rather than `block`: the line is readable in the system sans
         from the first paint, and the handwriting arrives when it arrives.
         Nothing on the page depends on this font having loaded. */
      @font-face {
        font-family: "Caveat";
        src: url("/fonts/caveat-400-latin.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <ScrollReveal />
    {
      umamiId && (
        <script
          defer
          is:inline
          src={`${umamiHost}/script.js`}
          data-website-id={umamiId}
        />
      )
    }
  </head>

  <body class="h-full w-full bg-background font-sans text-blackText antialiased">
    <slot />
  </body>
</html>
