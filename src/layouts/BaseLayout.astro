---
/**
 * @component BaseLayout
 * @version   1.0.1
 * @updated   2026-09-12
 * @source    astro-template@10c3958
 * @copied    2026-09-10
 * @modified  true
 *
 * Modified: applies the site's font stacks and text colour to <body> so every
 * page inherits them, sets `scroll-padding-top` so an in-page anchor does not
 * land underneath the sticky header, and mounts `ScrollReveal` — which has to
 * be in <head> to take effect before the first paint.
 *
 * NOTHING MAY GO BEFORE `<html>`, not even a comment. An Astro expression
 * ahead of the opening tag stops Astro treating that element as the document
 * root, and it emits the page with no `<html>`, `<head>` or `<body>` at all —
 * the browser rebuilds them, so the page still renders and no error is raised,
 * but every attribute on those three tags is gone: `lang`, the body's font and
 * background, `scroll-padding-top`, the lot. A note explaining the root
 * classes was enough to do it. Hence this paragraph, up here, where it is
 * safe.
 *
 * THE ROOT CLASSES, since they can no longer be annotated in place:
 *
 *   No `h-full` on either `<html>` or `<body>`. On a document ten thousand
 *   pixels long, `height: 100%` gives the body an 844px box that every section
 *   then overflows — `clientHeight` and `scrollHeight` disagreeing by an order
 *   of magnitude — and on a phone the percentage resolves against the viewport
 *   as it is while the URL bar is showing, so the box is wrong again the
 *   moment the bar collapses. Nothing here needs it; the pages that want to
 *   fill a short viewport say `min-h-screen`.
 *
 *   `scroll-smooth` sits behind `motion-safe:`, for the same reason every
 *   `animate-*` on this site does. Smooth scrolling is motion, and it is the
 *   kind a reader who asked for less of it most wants gone. It also
 *   interpolates against momentum scrolling on iOS, which can absorb a flick
 *   towards the top of the page. In-page anchors work either way; without it
 *   they jump.
 */
import ScrollReveal from "@ui/ScrollReveal.astro";
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  /** Document language, e.g. "nl" or "en". */
  lang?: string;
  /** Open Graph locale, e.g. "nl_NL". */
  locale?: string;
  /** Umami website id. Omit to ship no analytics at all. */
  umamiId?: string;
  /** Self-hosted Umami host, if you are not on Umami Cloud. */
  umamiHost?: string;
}

const {
  title = "",
  description = "",
  keywords = "",
  ogImage,
  lang = "nl",
  locale = "nl_NL",
  umamiId,
  umamiHost = "https://eu.umami.is",
} = Astro.props;
---

<html lang={lang} class="w-full motion-safe:scroll-smooth [scroll-padding-top:5rem]">
  <head>
    <meta charset="utf-8" />

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    {/* The icon is the wordmark reduced to what survives 16px: the `v` and
        its cobalt full stop, on the site's own silver. All four files are
        drawn by `scripts/make-favicon.py`, which is where the geometry and
        the reasoning live.

        The mask gets its own file. Safari fills every shape in a mask-icon
        with the colour from this tag, so handing it the full-colour SVG
        would paint the tile as well as the mark — one cobalt square. */}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon-mono.svg" color="#2563eb" />
    <link rel="apple-touch-icon" href="/apple-favicon.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* The site's only webfont: Caveat, for the pencilled annotations and the
        hero's opening line. Self-hosted, subset, 18 kB.

        The preload and the @font-face belong together and must stay together —
        a preload without a matching rule downloads a file nothing uses, and a
        @font-face without the preload is discovered only after the CSS has
        parsed, which is exactly when it is too late for text above the fold.
        `crossorigin` is required on a font preload even same-origin; without
        it the browser fetches the file twice. */}
    <link
      rel="preload"
      href="/fonts/caveat-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:image" content={ogImage} />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style is:global>
      /* `swap` rather than `block`: the line is readable in the system sans
         from the first paint, and the handwriting arrives when it arrives.
         Nothing on the page depends on this font having loaded. */
      @font-face {
        font-family: "Caveat";
        src: url("/fonts/caveat-400-latin.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <ScrollReveal />
    {
      umamiId && (
        <script
          defer
          is:inline
          src={`${umamiHost}/script.js`}
          data-website-id={umamiId}
        />
      )
    }
  </head>

  <body class="w-full bg-background font-sans text-blackText antialiased">
    <slot />
  </body>
</html>
