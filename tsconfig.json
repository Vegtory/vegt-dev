{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "astro-template/astro/icons"],
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["src/components/*"],
      "@template/*": ["astro-template/astro/components/*"]
    }
  }
}
