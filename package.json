{
	"name": "wil-astro-starter",
	"type": "module",
	"version": "0.0.1",
	"imports": {
		"#template/*": "./astro-template/astro/*",
		"#template-root/*": "./astro-template/*"
	},
	"scripts": {
		"dev": "npm run update && npx tinacms dev -c \"astro dev --port 8080\"",
		"start": "npm run update && npx tinacms dev -c \"astro dev --port 8080\"",
		"build": "npm run update && npx tinacms build && astro build",
		"preview": "astro preview --port 8080",
		"update": "cp -R ./astro-template/update-files/* ./"
	},
	"dependencies": {
		"@astrojs/mdx": "^4.2.6",
		"@astrojs/sitemap": "^3.2.1",
		"@astrojs/svelte": "^7.0.13",
		"@astrojs/tailwind": "^5.1.5",
		"@tinacms/cli": "^1.8.2",
		"astro": "^5.7.12",
		"astro-icon": "^1.1.5",
		"fs-extra": "^11.3.0",
		"svelte": "^5.28.2",
		"tailwind-fontawesome": "^0.7.1",
		"tailwindcss": "^3.4.17",
		"tinacms": "^2.6.2"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"dotenv": "^16.4.7",
		"dotenv-cli": "^8.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}
